# OpenAI API Key (如果使用 OpenAI 作为 LLM provider)
OPENAI_API_KEY=sk-your-api-key-here

# DeepSeek API Key (如果使用 DeepSeek)
DEEPSEEK_API_KEY=sk-your-api-key-here

# Ollama 不需要 API key，但如果需要可以设置
OLLAMA_API_KEY=ollama

# Bilibili Cookie (如果需要登录态获取弹幕)
# Optional SESSDATA cookie value only (not the entire browser Cookie header).
# Loaded only into a .bilibili.com-scoped cookie jar; never returned by APIs.
BILIBILI_SESSDATA=

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
WS_PORT=8765
# BigModel GLM-4-Flash (copy this file to .env and fill in your own key)
GLM_API_KEY=

# Optional MiniMax Turbo voice (keep Edge selected until configured)
MINIMAX_API_KEY=

# Optional Xiaomi MiMo voice, separate from the BigModel/GLM key
MIMO_API_KEY=

